{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" session-start --client claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" snapshot --client claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" plan --client claude",
            "timeout": 600,
            "statusMessage": "Reviewing the plan"
          },
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" necessity --client claude",
            "timeout": 600,
            "statusMessage": "Checking whether the task is needed"
          },
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" architecture --client claude",
            "timeout": 600,
            "statusMessage": "Checking architecture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" diff --client claude",
            "timeout": 600,
            "statusMessage": "Reviewing the diff"
          },
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" necessity --client claude",
            "timeout": 600,
            "statusMessage": "Checking whether the task is needed"
          },
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" architecture --client claude",
            "timeout": 600,
            "statusMessage": "Checking architecture"
          },
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" naming --client claude",
            "timeout": 600,
            "statusMessage": "Checking names"
          },
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" implementation --client claude",
            "timeout": 7200,
            "statusMessage": "Full implementation review"
          },
          {
            "type": "command",
            "command": "\"$(git -C \"${CLAUDE_PROJECT_DIR}\" rev-parse --show-toplevel)/.agent-hooks/run.sh\" proposal --client claude",
            "timeout": 7200,
            "statusMessage": "Full proposal review"
          }
        ]
      }
    ]
  }
}
